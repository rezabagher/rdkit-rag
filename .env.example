# Embedding model used to index the repository and embed queries.
# Any sentence-transformers model name works. Small models are fastest.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Ollama model used to answer questions ("ollama pull <model>" first).
OLLAMA_MODEL=qwen3:8b

# Ollama server host (default is fine for a local install).
OLLAMA_HOST=http://localhost:11434

# Optional: directory where the index is stored.
# RDKIT_RAG_DATA_DIR=.data

# Optional: skip files larger than this many bytes when scanning.
# RDKIT_RAG_MAX_FILE_SIZE_BYTES=1000000

# Optional: max lines per chunk before a large function is split.
# RDKIT_RAG_MAX_CHUNK_LINES=200
